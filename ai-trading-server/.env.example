# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/openalgo_trading
MONGODB_URI_PROD=mongodb+srv://user:password@cluster.mongodb.net/openalgo_trading

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# ─── OpenAlgo API ──────────────────────────────────────────────────────────────
OPENALGO_API_URL=http://localhost:5000
OPENALGO_API_KEY=your_openalgo_api_key

# ─── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=claude-opus-5-5
AI_ANALYSIS_ENABLED=true

# ─── OLLAMA (local AI) ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false

# ─── Market Data ───────────────────────────────────────────────────────────────
NSE_DATA_URL=https://www.nseindia.com
BSE_DATA_URL=https://www.bseindia.com
MARKET_TIMEZONE=Asia/Kolkata

# ─── Trading Configuration ─────────────────────────────────────────────────────
DEFAULT_RISK_PER_TRADE=1
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PERCENT=3
PAPER_TRADING=true

# ─── Alerts (optional) ─────────────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
